# Copiar a .env si se quiere sobreescribir algún valor por defecto.
# Ninguna de estas variables es secreta.

# Carpeta donde la API busca model.joblib, preprocessor.joblib y metadata.json.
# Por defecto ya apunta a models/ dentro del repo, normalmente no hace falta tocarla.
MODEL_DIR=models

# Probabilidad mínima para clasificar a un cliente como "en riesgo de churn".
CHURN_THRESHOLD=0.5
